---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { enlaces, persona } from '../data/sitio';

interface Props {
  title: string;
  description: string;
  /** Solo para páginas de casos de estudio: activa og:type "article". */
  articulo?: boolean;
}

const { title, description, articulo } = Astro.props;

// Astro.site viene de astro.config.mjs (la variable URL de Netlify en build,
// localhost en local). Astro.url.pathname ya trae la extensión .html propia
// de build.format 'file', así que la quitamos para las URLs canónicas/OG.
const ruta = Astro.url.pathname.replace(/(index)?\.html$/, '').replace(/\/$/, '') || '/';
const urlCanonica = new URL(ruta, Astro.site);
const urlOg = new URL('/og.png', Astro.site);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: persona.nombre,
  jobTitle: persona.titulo,
  url: Astro.site?.toString(),
  email: `mailto:${enlaces.correo}`,
  address: { '@type': 'Place', name: persona.ubicacion },
  sameAs: [enlaces.github, enlaces.linkedin],
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={urlCanonica} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Open Graph / Twitter: controla la vista previa al compartir el link
         (LinkedIn, WhatsApp, Slack...). urlOg apunta a /og.png, generada por
         scripts/generar-og.mjs a partir de public/og.svg. -->
    <meta property="og:type" content={articulo ? 'article' : 'website'} />
    <meta property="og:site_name" content={persona.nombreCorto} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={urlCanonica} />
    <meta property="og:image" content={urlOg} />
    <meta property="og:locale" content="es_MX" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={urlOg} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <!-- Marca que hay JavaScript antes de pintar, para que las animaciones de
         entrada solo oculten contenido cuando el script podrá mostrarlo.
         is:inline: Astro lo deja tal cual en el HTML, sin empaquetarlo. -->
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <Header />
    <main id="contenido" class="wrap" tabindex="-1">
      <slot />
    </main>
    <Footer />

    <script>
      // Astro empaqueta este script como módulo: se carga diferido,
      // una sola vez aunque el layout se use en varias páginas.
      import { iniciarInterfaz } from '../lib/interfaz';
      iniciarInterfaz();
    </script>
  </body>
</html>
