---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import EncabezadoPagina from '../components/EncabezadoPagina.astro';
import { enfoque, persona } from '../data/sitio';

const proyectos = (await getCollection('proyectos')).sort((a, b) => a.data.orden - b.data.orden);
---

<BaseLayout title={`Cómo trabajo — ${persona.nombreCorto}`} description={enfoque.intro}>
  <EncabezadoPagina titulo="Cómo trabajo" />

  <div class="texto">
    <p class="reveal">{enfoque.intro}</p>
    <p class="pull reveal" style="--i:1">{enfoque.cita}</p>
    <p class="reveal" style="--i:2">{enfoque.cierre}</p>
  </div>

  <!-- Enlaces a los casos donde se aplica este razonamiento -->
  <section class="casos" aria-labelledby="casos-title">
    <div class="section-head reveal">
      <h2 id="casos-title">Casos de estudio</h2>
    </div>
    <ol class="lista-lineas">
      {proyectos.map((p, i) => (
        <li class="reveal" style={`--i:${i}`}>
          <a href={`/proyectos/${p.id}`}>
            <span class="num">{String(p.data.orden).padStart(2, '0')}</span>
            <span class="titulo">{p.data.titulo}</span>
            <span class="linea">{p.data.unaLinea}</span>
            <span class="go" aria-hidden="true">→</span>
          </a>
        </li>
      ))}
    </ol>
  </section>
</BaseLayout>

<style>
  .texto { max-width: var(--container-lectura); }
  .texto p { margin: 0 0 22px; font-size: 18px; }
  .texto .pull {
    margin: 38px 0;
    padding-left: 24px;
    border-left: 2px solid var(--accent);
    font-family: var(--font-serif);
    font-size: clamp(25px, 3.4vw, 34px);
    line-height: 1.3;
  }

  .casos { padding-top: clamp(70px, 11vh, 110px); }

  ol {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  ol a {
    position: relative;
    display: grid;
    gap: 4px 20px;
    padding: 22px 36px 22px 0;
    border-bottom: 1px solid var(--line);
    transition: padding-left .5s var(--ease-out);
  }
  @media (min-width: 760px) {
    ol a {
      grid-template-columns: 40px 280px 1fr;
      align-items: baseline;
    }
  }
  ol a:hover,
  ol a:focus-visible { padding-left: 14px; }

  .num { font-family: var(--font-serif); font-size: 14px; color: var(--muted); transition: color .4s var(--ease-out); }
  .titulo { font-family: var(--font-serif); font-size: 21px; line-height: 1.3; }
  .linea { color: var(--muted); font-size: 15px; }

  .go {
    position: absolute;
    right: 4px;
    top: 50%;
    color: var(--accent);
    opacity: 0;
    transform: translate(-6px, -50%);
    transition: opacity .45s var(--ease-out), transform .45s var(--ease-out);
  }
  ol a:hover .go,
  ol a:focus-visible .go { opacity: 1; transform: translate(0, -50%); }
  ol a:hover .num,
  ol a:focus-visible .num { color: var(--accent); }
</style>
