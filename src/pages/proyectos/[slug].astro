---
import type { GetStaticPaths } from 'astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { persona } from '../../data/sitio';

// Enrutamiento dinámico: [slug] en el nombre del archivo es un parámetro.
// En un sitio estático Astro necesita saber de antemano qué páginas generar,
// así que getStaticPaths devuelve una entrada por proyecto (6 páginas).
export const getStaticPaths = (async () => {
  const proyectos = (await getCollection('proyectos')).sort((a, b) => a.data.orden - b.data.orden);
  return proyectos.map((proyecto, i) => ({
    params: { slug: proyecto.id },
    props: { proyecto, anterior: proyectos[i - 1], siguiente: proyectos[i + 1] },
  }));
}) satisfies GetStaticPaths;

interface Props {
  proyecto: CollectionEntry<'proyectos'>;
  anterior?: CollectionEntry<'proyectos'>;
  siguiente?: CollectionEntry<'proyectos'>;
}

const { proyecto, anterior, siguiente } = Astro.props;
const { orden, titulo, unaLinea, stack, etiqueta, enlace, estado, demo } = proyecto.data;
const numero = String(orden).padStart(2, '0');

// render() convierte el Markdown en un componente listo para usar como <Content />
const { Content } = await render(proyecto);

const dominio = enlace ? new URL(enlace).hostname : undefined;
---

<BaseLayout title={`${titulo} — ${persona.nombreCorto}`} description={unaLinea}>
  <article>
    <header class="cabecera">
      <p class="meta fade-up" style="--d:80">
        <span class="num">{numero}</span>
        {etiqueta && <span class="badge">{etiqueta}</span>}
        {estado && <span class="estado">{estado}</span>}
      </p>
      <h1 class="fade-up" style={`--d:160; view-transition-name: proyecto-${proyecto.id}`}>{titulo}</h1>
      <p class="una-linea fade-up" style="--d:260">{unaLinea}</p>
      <ul class="stack fade-up" style="--d:360" aria-label="Tecnologías">
        {stack.map((item) => <li class="chip">{item}</li>)}
      </ul>
      {(enlace || demo) && (
        <div class="acciones fade-up" style="--d:440">
          {enlace && (
            <a class="btn" href={enlace} rel="noopener" target="_blank">
              Ver en línea: {dominio} <span class="arrow" aria-hidden="true">↗</span>
              <span class="sr-only">(se abre en otra pestaña)</span>
            </a>
          )}
          {demo?.tipo === 'sitio' && (
            <a class="btn btn-ghost" href={demo.url} rel="noopener" target="_blank">
              Ver demo <span class="arrow" aria-hidden="true">↗</span>
              <span class="sr-only">(se abre en otra pestaña)</span>
            </a>
          )}
          {demo?.tipo === 'descarga' && (
            <a class="btn btn-ghost" href={demo.url} download>
              Descargar demo <span class="arrow" aria-hidden="true">↓</span>
            </a>
          )}
          {demo?.nota && <p class="nota-demo">{demo.nota}</p>}
        </div>
      )}
    </header>

    <div class="cuerpo">
      <Content />
    </div>

    <nav class="vecinos" aria-label="Otros casos de estudio">
      {anterior ? (
        <a class="vecino" href={`/proyectos/${anterior.id}`} rel="prev">
          <span class="direccion">← Anterior</span>
          <span class="titulo-vecino">{anterior.data.titulo}</span>
        </a>
      ) : <span />}
      {siguiente && (
        <a class="vecino siguiente" href={`/proyectos/${siguiente.id}`} rel="next">
          <span class="direccion">Siguiente →</span>
          <span class="titulo-vecino">{siguiente.data.titulo}</span>
        </a>
      )}
    </nav>
  </article>
</BaseLayout>

<style>
  article {
    padding-top: clamp(130px, 20vh, 190px);
  }

  /* ---------- cabecera ---------- */
  .cabecera {
    max-width: 820px;
    padding-bottom: 46px;
    margin-bottom: 56px;
    border-bottom: 1px solid var(--line);
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 6px 14px;
    margin: 0 0 18px;
  }
  .num { font-family: var(--font-serif); font-size: 16px; color: var(--accent); }
  .badge,
  .estado {
    font-size: 11.5px;
    letter-spacing: 1.4px;
    text-transform: uppercase;
  }
  .badge { color: var(--accent); }
  .estado { color: var(--muted); }

  h1 {
    margin: 0 0 22px;
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: clamp(40px, 6.4vw, 76px);
    line-height: 1.05;
    letter-spacing: -.4px;
    width: fit-content;
  }

  .una-linea {
    max-width: 640px;
    margin: 0 0 28px;
    font-size: clamp(17px, 2vw, 20px);
    color: var(--muted);
  }

  .stack {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .chip {
    padding: 4px 11px;
    border: 1px solid var(--line);
    border-radius: 999px;
    font-size: 12.5px;
    color: var(--muted);
  }

  .acciones {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px;
    margin-top: 34px;
  }
  .nota-demo {
    flex-basis: 100%;
    margin: 0;
    font-size: 14px;
    color: var(--muted);
  }

  /* ---------- cuerpo ----------
     El HTML que produce <Content /> viene del Markdown y no lleva el atributo
     de alcance de este componente, por eso los selectores usan :global(). */
  .cuerpo {
    max-width: var(--container-lectura);
  }

  .cuerpo :global(h2) {
    margin: 64px 0 18px;
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: clamp(27px, 3.4vw, 34px);
    line-height: 1.2;
    letter-spacing: -.2px;
  }
  .cuerpo :global(h2:first-child) { margin-top: 0; }

  .cuerpo :global(h3) {
    margin: 40px 0 10px;
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 400;
    font-size: clamp(21px, 2.6vw, 25px);
    line-height: 1.3;
    color: var(--ink);
  }
  .cuerpo :global(h2 + h3) { margin-top: 8px; }

  .cuerpo :global(p) { margin: 0 0 20px; }

  .cuerpo :global(ul) {
    margin: 0 0 20px;
    padding: 0;
    list-style: none;
  }
  .cuerpo :global(li) {
    position: relative;
    padding-left: 26px;
    margin-bottom: 12px;
  }
  .cuerpo :global(li)::before {
    content: "";
    position: absolute;
    left: 0;
    top: .85em;
    width: 12px;
    height: 1px;
    background: var(--accent);
  }

  .cuerpo :global(a) {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* ---------- anterior / siguiente ---------- */
  .vecinos {
    display: grid;
    gap: 18px;
    margin-top: 90px;
    padding-top: 36px;
    border-top: 1px solid var(--line);
  }
  @media (min-width: 700px) {
    .vecinos { grid-template-columns: 1fr 1fr; }
  }

  .vecino {
    display: grid;
    gap: 6px;
    padding: 22px 24px;
    border: 1px solid var(--line);
    border-radius: 16px;
    transition: transform .55s var(--ease-out), box-shadow .55s var(--ease-out), border-color .4s var(--ease-out);
  }
  .vecino:hover,
  .vecino:focus-visible {
    transform: translateY(-3px);
    box-shadow: 0 14px 34px var(--shadow);
    border-color: transparent;
  }
  .siguiente { text-align: right; }
  @media (min-width: 700px) {
    .siguiente { grid-column: 2; }
  }

  .direccion {
    font-size: 13px;
    letter-spacing: 1px;
    color: var(--muted);
    transition: color .4s var(--ease-out);
  }
  .vecino:hover .direccion,
  .vecino:focus-visible .direccion { color: var(--accent); }

  .titulo-vecino {
    font-family: var(--font-serif);
    font-size: 22px;
    line-height: 1.25;
  }
</style>
