---
import { enlaces, persona } from '../data/sitio';
---

<footer id="contacto" class="wrap">
  <h2 class="reveal">¿Trabajamos juntos?</h2>
  <ul class="links reveal" style="--i:1">
    <li>
      <a class="link-u" href={`mailto:${enlaces.correo}`}>{enlaces.correo}</a>
      <button type="button" class="copiar" data-correo={enlaces.correo} aria-label={`Copiar ${enlaces.correo} al portapapeles`}>
        <span class="etiqueta">Copiar</span>
      </button>
    </li>
    <li><a class="link-u" href={enlaces.github}>GitHub</a></li>
    <li><a class="link-u" href={enlaces.linkedin}>LinkedIn</a></li>
    <li><a class="link-u" href={enlaces.cv} download>Descargar CV</a></li>
  </ul>
  <div class="base">
    <span>{persona.ubicacion}</span>
    <span>© 2026</span>
  </div>
</footer>

<script>
  // Un botón por página basta: el footer no se repite en el documento.
  const boton = document.querySelector<HTMLButtonElement>('.copiar');
  const etiqueta = boton?.querySelector('.etiqueta');
  let vigencia: ReturnType<typeof setTimeout> | undefined;

  boton?.addEventListener('click', async () => {
    const correo = boton.dataset.correo;
    if (!correo || !etiqueta) return;
    try {
      await navigator.clipboard.writeText(correo);
      etiqueta.textContent = 'Copiado';
    } catch {
      etiqueta.textContent = 'No se pudo copiar';
    }
    clearTimeout(vigencia);
    vigencia = setTimeout(() => {
      etiqueta.textContent = 'Copiar';
    }, 1800);
  });
</script>

<style>
  footer {
    padding-top: clamp(70px, 11vh, 120px);
  }

  footer::before {
    content: "";
    display: block;
    border-top: 1px solid var(--line);
    margin-bottom: clamp(70px, 11vh, 120px);
  }

  h2 {
    margin: 0 0 28px;
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: clamp(34px, 6vw, 64px);
    line-height: 1.1;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 28px;
    margin: 0;
    padding: 0;
    list-style: none;
    color: var(--muted);
    font-size: 16px;
  }

  .links li:first-child {
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }

  .copiar {
    padding: 3px 12px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: none;
    color: var(--muted);
    font-size: 12px;
    letter-spacing: .3px;
    cursor: pointer;
    transition: border-color .3s var(--ease-out), color .3s var(--ease-out);
  }
  .copiar:hover,
  .copiar:focus-visible { border-color: var(--accent); color: var(--ink); }

  .base {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 10px;
    padding: 40px 0 calc(48px + env(safe-area-inset-bottom, 0px));
    color: var(--muted);
    font-size: 13.5px;
  }
</style>
