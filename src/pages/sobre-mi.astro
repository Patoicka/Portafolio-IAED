---
import BaseLayout from '../layouts/BaseLayout.astro';
import EncabezadoPagina from '../components/EncabezadoPagina.astro';
import { educacion, enlaces, habilidades, idiomas, persona, sobreMi } from '../data/sitio';
---

<BaseLayout title={`Sobre mí — ${persona.nombreCorto}`} description={sobreMi[0]}>
  <EncabezadoPagina titulo="Sobre mí" antetitulo={persona.nombre} />

  <div class="texto">
    {sobreMi.map((parrafo, i) => (
      <p class="reveal" style={`--i:${Math.min(i, 2)}`}>{parrafo}</p>
    ))}
  </div>

  <section class="bloque" aria-labelledby="habilidades-title">
    <div class="section-head reveal">
      <h2 id="habilidades-title">Habilidades técnicas</h2>
    </div>
    <dl class="habilidades lista-lineas">
      {habilidades.map(({ area, items }, i) => (
        <div class="fila reveal" style={`--i:${i % 3}`}>
          <dt>{area}</dt>
          <dd>{items}</dd>
        </div>
      ))}
    </dl>
  </section>

  <div class="dos-columnas">
    <section class="bloque" aria-labelledby="educacion-title">
      <div class="section-head reveal">
        <h2 id="educacion-title">Educación</h2>
      </div>
      <p class="reveal dato">
        <span class="principal">{educacion.carrera}</span>
        <span>{educacion.escuela}</span>
        <span class="apagado">{educacion.periodo}</span>
      </p>
    </section>

    <section class="bloque" aria-labelledby="idiomas-title">
      <div class="section-head reveal">
        <h2 id="idiomas-title">Idiomas</h2>
      </div>
      <dl class="idiomas">
        {idiomas.map(({ idioma, nivel }, i) => (
          <div class="reveal" style={`--i:${i}`}>
            <dt>{idioma}</dt>
            <dd>{nivel}</dd>
          </div>
        ))}
      </dl>
    </section>
  </div>

  <p class="cv reveal">
    <a class="btn btn-ghost" href={enlaces.cv} download>Descargar CV <span class="arrow" aria-hidden="true">↓</span></a>
  </p>
</BaseLayout>

<style>
  .texto { max-width: var(--container-lectura); }
  .texto p { margin: 0 0 22px; font-size: 18px; }

  .bloque { padding-top: clamp(64px, 10vh, 100px); }

  dl { margin: 0; }
  dd { margin: 0; }

  .fila {
    display: grid;
    gap: 4px;
    padding: 18px 0;
    border-bottom: 1px solid var(--line);
  }
  @media (min-width: 760px) {
    .fila { grid-template-columns: 200px 1fr; gap: 28px; align-items: baseline; }
  }
  .fila dt { font-family: var(--font-serif); font-size: 20px; }
  .fila dd { color: var(--muted); }

  .dos-columnas { display: grid; column-gap: 56px; }
  @media (min-width: 860px) {
    .dos-columnas { grid-template-columns: 1fr 1fr; }
  }

  .dato { display: grid; gap: 2px; margin: 0; }
  .principal { font-family: var(--font-serif); font-size: 22px; line-height: 1.3; }
  .apagado { color: var(--muted); font-size: 15px; }

  .idiomas { display: grid; gap: 16px; }
  .idiomas dt { font-family: var(--font-serif); font-size: 22px; line-height: 1.3; }
  .idiomas dd { color: var(--muted); }

  .cv { margin: 56px 0 0; }
</style>
